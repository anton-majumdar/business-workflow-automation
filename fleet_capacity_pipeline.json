      "typeVersion": 1,
      "position":
    },
    {
      "parameters": {
        "title": "Dispatch Allocation: {{ $json.body.Tracking_ID }}",
        "description": "Automated capacity overflow management.\nWeight: {{ $json.body.Weight_KG }} KG\nOrigin: Manifest Analysis Export.",
