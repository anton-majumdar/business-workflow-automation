      "type": "n8n-nodes-base.asana",
      "typeVersion": 1,
      "position":
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [
        [
          {
            "node": "Filter High Priority",
            "type": "main",
            "index": 
          }
        ]
      ]
    },
    "Filter High Priority": {
      "main": [
        [
          {
            "node": "Push to Slack",
            "type": "main",
            "index": 
          }
        ],
        [
          {
            "node": "Create Asana Task",
            "type": "main",
            "index": 
          }
        ]
      ]
